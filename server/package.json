{
  "name": "fairclaim-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.mts",
    "test:run": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "tsx prisma/production-seed.ts",
    "db:local": "tsx scripts/local-db.mts",
    "rpc:check": "tsx scripts/check-rpc.mts",
    "sgt:diagnose": "tsx scripts/diagnose-sgt-rpc.mts",
    "preflight:seeker": "tsx scripts/preflight-seeker.mts",
    "seeker:configure": "tsx scripts/configure-seeker.mts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@solana/kit": "^8.0.0",
    "@solana-program/token-2022": "0.16.1",
    "@solana/wallet-standard-util": "1.1.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}

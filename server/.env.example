NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fairclaim:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@127.0.0.1:5432/fairclaim
# Mainnet only. Replace with a private provider URL if the public endpoint is limited.
# This value is SERVER ONLY. Never put a paid RPC URL in mobile/.env.
SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_SERVER_ONLY_HELIUS_API_KEY
SIWS_DOMAIN=localhost:3000
SIWS_URI=http://localhost:3000
CORS_ORIGINS=
DEV_SGT_BYPASS=false
SGT_VERIFY_ONLY_MODE=false
CLAIM_TEST_MODE=false
# Explicit production/staging gate for database-only Genesis Access claims.
# Keep false until the public HTTPS deployment is ready to accept claims.
DATABASE_CLAIMS_ENABLED=false
